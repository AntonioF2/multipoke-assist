{
  "manifest_version": 3,
  "name": "MultiPoke Assist",
  "version": "1.5.36",
  "description": "Capturas, suprimentos, vendas, hunts, Pokédex e tierlist para o MultiPoke Idle.",
  "key": "",
  "permissions": ["scripting"],
  "host_permissions": ["https://multipoke.io/*"],
  "background": {
    "service_worker": "barra.js"
  },
  "content_scripts": [
    {
      "matches": ["https://multipoke.io/jogar*"],
      "js": ["autocaptura.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://multipoke.io/jogar*"],
      "js": ["avisos.js", "dados-hunts.js", "combate-hunts.js", "analise-hunts.js", "troca-hunts.js", "testes-hunts.js", "tierlist.js", "pokedex.js", "loja.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["dragonite.png"], "matches": ["https://multipoke.io/*"] }
  ],
  "icons": {
    "128": "icone-128.png"
  },
  "action": {
    "default_title": "MultiPoke Assist — Mostrar ou ocultar painel"
  }
}
