{
  "manifest_version": 3,
  "name": "MultiPoke Autocaptura",
  "version": "1.5.24",
  "description": "Inicia a autocaptura e carrega o painel Auto Loja ao abrir o MultiPoke Idle.",
  "key": "",
  "permissions": ["scripting"],
  "host_permissions": ["https://multipoke.io/*"],
  "background": {
    "service_worker": "barra.js"
  },
  "content_scripts": [
    {
      "matches": ["https://multipoke.io/jogar*"],
      "js": ["autocaptura.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://multipoke.io/jogar*"],
      "js": ["dados-hunts.js", "combate-hunts.js", "analise-hunts.js", "troca-hunts.js", "loja.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["dragonite.png"], "matches": ["https://multipoke.io/*"] }
  ],
  "icons": {
    "128": "icone-128.png"
  },
  "action": {
    "default_title": "MultiPoke Autocaptura — Mostrar ou ocultar painel"
  }
}
