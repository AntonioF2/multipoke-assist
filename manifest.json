{
  "manifest_version": 3,
  "name": "MultiPoke Autocaptura",
  "version": "1.4.1",
  "description": "Ativa a captura e o painel de reposição na aba aberta do MultiPoke Idle.",
  "key": "",
  "permissions": ["scripting"],
  "host_permissions": ["https://multipoke.io/*"],
  "web_accessible_resources": [
    { "resources": ["dragonite.png"], "matches": ["https://multipoke.io/*"] }
  ],
  "action": {
    "default_title": "Ativar autocaptura do MultiPoke",
    "default_popup": "ativar.html"
  }
}
